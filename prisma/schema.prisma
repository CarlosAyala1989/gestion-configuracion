  ownerId      String
  fileName     String
  mimeType     String?
  storagePath  String
  sha256Hash   String           @db.Char(64)
  version      String?
  status       AttachmentStatus @default(ACTIVE)
  uploadedById String           @db.VarChar(36)
  createdAt    DateTime         @default(now())

  project    Project @relation(fields: [projectId], references: [id])
  uploadedBy User    @relation("AttachmentUploader", fields: [uploadedById], references: [id])

  @@index([ownerType, ownerId])
  @@map("attachments")
}
